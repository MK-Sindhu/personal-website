# Only the website is published: the page and the images it uses.
# Everything else here (resume, references, original photos, prompts, notes) stays local.
/*
!/.gitignore
!/index.html
!/images/
/images/*
!/images/hero.jpg
!/images/contact.jpg
!/images/aws-*.png
!/images/icon-*.png
!/images/apple-touch-icon.png
